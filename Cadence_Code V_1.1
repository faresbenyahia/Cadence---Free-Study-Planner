/* ════════════════ VIEW: Progress ════════════════ */
function viewProgress(){
  let doneR=0,totR=0;
  const courseProg=[];
  for(const c of state.courses){
    let cd=0,ct=0;
    for(const ch of c.chapters){ doneR+=ch.repsDone; totR+=Math.max(ch.target,ch.repsDone); cd+=ch.repsDone; ct+=Math.max(ch.target,ch.repsDone); }
    courseProg.push({c,p:ct?cd/ct:0});
  }
  const overall=totR?doneR/totR:0;
  const R=54,C=2*Math.PI*R;
  const today=startOfToday();
  const loads=loadByISO();
  const week=[...Array(7)].map((_,i)=>{const d=addD(today,i);return {d,v:loads[toISO(d)]||0};});
  const mx=Math.max(...week.map(w=>w.v),1);
  const mastered=state.courses.reduce((n,c)=>n+c.chapters.filter(ch=>ch.status==="done").length,0);
  const totalCh=state.courses.reduce((n,c)=>n+c.chapters.length,0);
  const doneHist=state.history.filter(h=>h.status==="done");
  const att=attentionList(5);
  const st=streak();
  return `<div class="view">
    <div class="vhead"><div><div class="eyebrow">${t("progress_eyebrow")}</div><h1 class="serif">${t("progress_title")}</h1></div></div>
    <div class="two-col" style="margin-bottom:16px">
      <div class="card p ring-wrap">
        <svg width="132" height="132"><circle class="ring-bg" cx="66" cy="66" r="${R}" fill="none" stroke-width="12"/>
          <circle class="ring-fg" cx="66" cy="66" r="${R}" fill="none" stroke-width="12" stroke-dasharray="${C}" stroke-dashoffset="${C*(1-overall)}"/></svg>
        <div><div class="num serif" style="font-size:38px">${Math.round(overall*100)}%</div>
          <div class="label">${t("ring_label")}</div>
          <div style="margin-top:8px;font-size:13px;color:var(--mut)">${t("prog_detail",{a:doneR,b:totR,c:mastered,d:totalCh})}</div></div>
      </div>
      <div class="card p">
        <div class="label" style="margin-bottom:4px">${t("load_week")}</div>
        <div class="bars">${week.map((w,i)=>`<div class="barcol ${i===0?"now":""} ${w.v===mx&&mx>0?"hot":""}">
          <span class="bv">${w.v?fmtDur(w.v):""}</span><div class="b" style="height:${Math.round(w.v/mx*82)}%"></div><span class="bl">${L().wdMin[i]}</span></div>`).join("")}</div>
      </div>
    </div>
    <div class="pgrid">
