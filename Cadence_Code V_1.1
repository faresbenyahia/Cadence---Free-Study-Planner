  return [
    {id:uid(),name:"Mathematics",color:PALETTE[0],importance:3,chapters:[mk("Integrals",15),mk("Derivatives",70),mk("Complex numbers",40)]},
    {id:uid(),name:"Physics",color:PALETTE[1],importance:2,chapters:[mk("Electromagnetism",25),mk("Mechanics",55),mk("Optics",10)]},
    {id:uid(),name:"English",color:PALETTE[2],importance:1,chapters:[mk("Grammar",80),mk("Vocabulary",50)]},
    {id:uid(),name:"History",color:PALETTE[3],importance:2,chapters:[mk("French Revolution",35),mk("Colonial era",5)]},
  ];
}

/* ════════════════ Event delegation ════════════════ */
function fillRange(el){
  const min=+el.min||0, max=+el.max||100, p=((+el.value-min)/(max-min))*100;
  el.style.setProperty("--p",p+"%");
}
function refreshFills(){ document.querySelectorAll("input[type=range]").forEach(fillRange); }
function fmtRangeOut(el){
  const f=el.dataset.fmt, v=+el.value;
  if(f==="dur") return fmtDur(v);
  if(f==="pct") return v+"%";
  if(f==="imp") return impWord(v)+" "+impDots(v);
  return v+"%";
}

document.addEventListener("input", e=>{
  const tEl=e.target;
  if(tEl.matches("input[type=range]")){
    fillRange(tEl);
    if(tEl.dataset.out){ const o=$(tEl.dataset.out); if(o) o.textContent=fmtRangeOut(tEl); }
    if(tEl.dataset.live){ const o=$(tEl.dataset.live); if(o) o.textContent=fmtRangeOut(tEl); }
    if(["cmp-slider","uk-slider","chf-k"].includes(tEl.id)){ tEl.className = +tEl.value<40?"k-low":+tEl.value<70?"k-mid":"k-hi"; }
  }
  if(tEl.matches("input[data-exam-ch]")){ tEl.checked ? examPickedCh.add(tEl.dataset.examCh) : examPickedCh.delete(tEl.dataset.examCh); }
  if(tEl.matches("input[data-exam-course]")){ tEl.checked ? examPickedCourse.add(tEl.dataset.examCourse) : examPickedCourse.delete(tEl.dataset.examCourse); }
});
document.addEventListener("change", e=>{
  const tEl=e.target; if(!tEl.matches("input[data-bind]")) return;
  const b=tEl.dataset.bind, v=+tEl.value;
  if(b==="today"){ state.overrides[toISO(startOfToday())]=v; rebuild(); render(); }
  if(b==="avail"){ state.availability[+tEl.dataset.id]=v; rebuild(); render(); toast(t("toast_avail"),"good"); }
  if(b==="know"){ setKnowledge(tEl.dataset.id, v); }
  if(b==="imp"){
    const c=state.courses.find(x=>x.id===tEl.dataset.id); if(c){ c.importance=v; rebuild(); render(); toast(t("toast_imp",{w:impWord(v)})); }
  }
});

document.addEventListener("click", e=>{
  const el=e.target.closest("[data-act]"); if(!el) return;
  const {act,id,id2}=el.dataset;
  switch(act){
    case "nav": closeModal(); show(id); break;
    case "closeModal": closeModal(); break;
    case "toggleTheme": toggleTheme(); break;
    case "calPrev": weekOffset--; render(); break;
    case "calNext": weekOffset++; render(); break;
    case "calNow": weekOffset=0; render(); break;
    case "setLang": setLocale(id); break;
    case "welcomeLang": state.settings.locale=id; Store.save(state); document.documentElement.lang=id; renderNav(); render(); welcomeModal(); break;
    case "welcomeGo": onboarding(); break;

    case "startTutorial": tutStep=0; tutorialModal(); break;
    case "tutNext": tutStep=Math.min(TUT_STEPS.length-1,tutStep+1); tutorialModal(); break;
    case "tutPrev": tutStep=Math.max(0,tutStep-1); tutorialModal(); break;
    case "tutSkip": tutorialChoiceModal(); break;
    case "tutFinish": tutorialChoiceModal(); break;
    case "tutChoice": {
      if(id==="sample"){ state.courses=sampleCourses(); }
      state.onboarded=true; Store.save(state); rebuild(); closeModal(); render();
      toast(id==="sample"?t("toast_sample"):t("toast_onb"),"good");
      break; }

    case "openSess": sessDetail(id); break;
    case "startSession": startSession(id); break;
    case "finishSession": finishStudySession(id); break;
    case "resumeSession": resumeSession(); break;
    case "pauseSession": pauseSession(); break;
    case "startBreak": startBreak(); break;
    case "exitSession": endStudySession(); break;
    case "completeOpen": completeModal(id); break;
    case "completeSave": { const v=+($("#cmp-slider")?.value||0); const mins=activeStudySession?.elapsed?Math.max(1,Math.round(activeStudySession.elapsed/60)):null; activeStudySession=null; closeModal(); completeSession(id,v,mins); break; }
    case "kPreset": {
      const s=state.schedule.find(x=>x.id===id); const f=s&&findChapter(s.chapterId); if(!f) break;
      const k=f.ch.knowledge;
      const map={strug:clampN(k-10,0,100), impr:clampN(k+15,0,100), comf:clampN(k+30,0,100), mast:95};
      const sl=$("#cmp-slider"); sl.value=map[id2]; fillRange(sl);
      $("#cmp-val").textContent=map[id2]+"%";
      sl.className = map[id2]<40?"k-low":map[id2]<70?"k-mid":"k-hi";
      document.querySelectorAll(".preset").forEach(p=>p.classList.toggle("sel",p===el));
      break; }
    case "missSess": closeModal(); missSession(id); break;
    case "missDay": confirmModal(t("confirm_miss_day"), "missDayGo", id); break;
    case "missDayGo": closeModal(); markMissedDay(id); break;
    case "undoMissed": undoMissed(id); break;
    case "updateK": knowledgeModal(id); break;
    case "saveK": { const v=+($("#uk-slider")?.value||0); closeModal(); setKnowledge(id,v); break; }
    case "restartCh": restartChapter(id); break;
    case "reviewAgain": reviewAgain(id); break;

    case "addCourse": courseModal(null); break;
    case "editCourse": courseModal(id); break;
    case "saveCourse": {
      const name=($("#cf-name")?.value||"").trim();
      if(!name){ toast(t("toast_name_course"),"bad"); break; }
      const imp=+($("#cf-imp")?.value||2);
      if(id){ const c=state.courses.find(x=>x.id===id); c.name=name; c.importance=imp; toast(t("toast_course_saved")); }
      else{
        const used={}; for(const c of state.courses) used[c.color]=1;
        const color=PALETTE.find(p=>!used[p])||PALETTE[state.courses.length%PALETTE.length];
        state.courses.push({id:uid(),name,color,importance:imp,chapters:[]});
        toast(t("toast_course_added"),"good");
      }
      closeModal(); rebuild(); render(); break; }
    case "delCourse": { const c=state.courses.find(x=>x.id===id); confirmModal(t("confirm_del_course",{name:esc(c.name),n:c.chapters.length}), "delCourseGo", id); break; }
    case "delCourseGo": state.courses=state.courses.filter(c=>c.id!==id); closeModal(); rebuild(); render(); toast(t("toast_course_del")); break;

    case "addChapter": chapterModal(id,null); break;
    case "editChapter": chapterModal(id,id2); break;
    case "saveChapter": {
      const c=state.courses.find(x=>x.id===id); if(!c) break;
      const name=($("#chf-name")?.value||"").trim();
      if(!name){ toast(t("toast_name_chapter"),"bad"); break; }
      const k=+($("#chf-k")?.value||0); c.importance=+($("#chf-imp")?.value||c.importance);
      if(id2){ const ch=c.chapters.find(x=>x.id===id2); ch.name=name; setKnowledgeInline(ch,k); toast(t("toast_ch_saved")); }
      else{
        c.chapters.push({id:uid(),name,knowledge:k,initial:k,repsDone:0,target:Engine.remainingReps(k),status:"active",lastStudied:null,dueDate:null,examDeadline:null});
        toast(k===0?t("toast_ch_new",{name}):t("toast_ch_added",{name}), "good");
      }
      closeModal(); rebuild(); render(); break; }
    case "delChapter": { const f=findChapter(id2); confirmModal(t("confirm_del_chapter",{name:esc(f.ch.name)}), "delChapterGo", id+":"+id2); break; }
    case "delChapterGo": { const [cid,chid]=id.split(":"); const c=state.courses.find(x=>x.id===cid); c.chapters=c.chapters.filter(x=>x.id!==chid); closeModal(); rebuild(); render(); toast(t("toast_ch_del")); break; }
    case "moveCh": {
      const c=state.courses.find(x=>x.id===id); const [chid,dir]=id2.split(":");
      const i=c.chapters.findIndex(x=>x.id===chid); const j=dir==="up"?i-1:i+1;
      if(j>=0&&j<c.chapters.length){ [c.chapters[i],c.chapters[j]]=[c.chapters[j],c.chapters[i]]; Store.save(state); render(); }
      break; }

    case "export": {
      const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
      const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download="cadence-plan.json"; a.click();
      toast(t("toast_export"),"good"); break; }
    case "importBtn": $("#import-file").click(); break;
    case "sample": state.courses=sampleCourses(); rebuild(); render(); toast(t("toast_sample"),"good"); break;
    case "reset": confirmModal(t("confirm_reset"), "resetGo"); break;
    case "resetGo": Store.clear(); location.reload(); break;

    case "onbGo": {
      document.querySelectorAll("input[data-bind2=onb]").forEach(r=>state.availability[+r.dataset.id]=+r.value);
      if($("#onb-sample")?.checked) state.courses=sampleCourses();
      state.onboarded=true; Store.save(state); rebuild(); closeModal(); render();
      toast(t("toast_onb"),"good"); break; }

    case "openExam": examModal(); break;
    case "examScopeSet": {
      examScope=id;
      $("#exam-seg").querySelectorAll("button").forEach(b=>b.classList.toggle("on", b.dataset.id===id));
      $("#exam-pick").innerHTML=examPickHTML();
      break; }
    case "examSave": {
      const dateVal=$("#exam-date")?.value;
      if(!dateVal || dateVal<=toISO(startOfToday())){ toast(t("exam_past_date"),"bad"); break; }
      let chapterIds=[];
      if(examScope==="course"){
        for(const cid of examPickedCourse){ const c=state.courses.find(x=>x.id===cid); if(c) chapterIds.push(...c.chapters.map(ch=>ch.id)); }
      } else chapterIds=[...examPickedCh];
      if(!chapterIds.length){ toast(t("exam_none_sel"),"bad"); break; }
      closeModal(); addExam(dateVal, chapterIds); break; }
    case "delExam": { const ex=state.exams.find(x=>x.id===id); confirmModal(t("confirm_del_chapter",{name:fmtDate(fromISO(ex.date))}), "delExamGo", id); break; }
    case "delExamGo": closeModal(); deleteExam(id); break;
  }
});
$("#import-file")?.addEventListener("change", e=>{
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=()=>{ try{ const obj=JSON.parse(r.result); if(!obj.courses||!Array.isArray(obj.courses)) throw 0;
      state=Object.assign(defaultState(),obj);
      state.settings=Object.assign({locale:"en"},state.settings||{});
      if(!Array.isArray(state.exams)) state.exams=[];
      document.documentElement.lang=state.settings.locale;
      Store.save(state); rebuild(); render(); toast(t("toast_import_ok"),"good");
    }catch(_){ toast(t("toast_import_bad"),"bad"); } };
  r.readAsText(f);
});
function setKnowledgeInline(ch,k){
  ch.knowledge=k;
  const rem = k>=100&&ch.repsDone>0 ? 1 : Engine.remainingReps(k);
  ch.target=Math.max(ch.repsDone+(k>=100&&ch.repsDone>0?0:1), ch.repsDone+rem);
  ch.status = ch.target<=ch.repsDone ? "done":"active";
}

/* ════════════════ Dark mode ════════════════ */
const THEME_KEY="cadence.theme";
function applyTheme(theme){
  document.documentElement.setAttribute("data-theme", theme);
  const icon = theme==="dark" ? ico("sun",19) : ico("moon",19);
  const btn=$("#theme-toggle");
  if(btn) btn.innerHTML = icon;
  const sbtn=$("#study-focus-theme");
  if(sbtn) sbtn.innerHTML = icon;
}
function initTheme(){
  let theme=localStorage.getItem(THEME_KEY);
  if(!theme) theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  applyTheme(theme);
}
function toggleTheme(){
  const cur=document.documentElement.getAttribute("data-theme")==="dark" ? "dark" : "light";
  const next=cur==="dark" ? "light" : "dark";
  localStorage.setItem(THEME_KEY, next);
  applyTheme(next);
}

/* ════════════════ Boot ════════════════ */
(function boot(){
  document.documentElement.lang = state.settings.locale;
  initTheme();
  const today=toISO(startOfToday());
  const stale=state.schedule.filter(s=>s.date<today);
  if(stale.length){
    for(const s of stale){
      const f=findChapter(s.chapterId);
      if(f){ state.history.push({...s,status:"missed",courseName:f.c.name,chapterName:f.ch.name}); f.ch.dueDate=toISO(addD(fromISO(s.date),1)); }
    }
    state.schedule=state.schedule.filter(s=>s.date>=today);
    setTimeout(()=>toast(t("toast_stale",{n:stale.length}),"bad"),900);
  }
  recomputeExamDeadlines();
  rebuild(); renderNav(); render();
  if(!state.onboarded) welcomeModal();
})();
</script>
