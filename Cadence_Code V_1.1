<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Cadence — Spaced Study Planner</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='4' y='18' width='5' height='10' rx='2' fill='%232E6B4F'/%3E%3Crect x='13' y='11' width='5' height='17' rx='2' fill='%23B0752B'/%3E%3Crect x='22' y='4' width='5' height='24' rx='2' fill='%23182420'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Public+Sans:wght@400;500;600;700;800&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#182420; --ink2:#24352D; --paper:#F2F4EF; --panel:#FFFFFF;
  --line:#E1E6DD; --line2:#D2DACD;
  --mut:#5F6E64; --faint:#8A968C;
  --prim:#2E6B4F; --prim-d:#235540; --prim-t:#E2EEE7;
  --ochre:#B0752B; --ochre-t:#F5E9D8;
  --clay:#B24A3A; --clay-t:#F6E3DF;
  --rail:#14201B; --rail-t:#9DB4A8;
  --shadow:0 10px 24px -14px rgba(24,36,32,.35);
  --r:12px;
  --soft:#F7F9F4; --soft2:#EDF1E9; --chipbg:#EEF1EA; --inputbg:#FCFDFB; --overlay:rgba(255,255,255,.55);
}
:root[data-theme="dark"]{
  --soft:#1E2620; --soft2:#212A23; --chipbg:#232C25; --inputbg:#1C241E; --overlay:rgba(255,255,255,.035);
}
:root[data-theme="dark"]{
  --ink:#EAF0EB; --ink2:#D3DED6; --paper:#121712; --panel:#1A211B;
  --line:#2B342C; --line2:#39443A;
  --mut:#93A196; --faint:#67746B;
  --prim:#59BF8F; --prim-d:#3E9670; --prim-t:#1E3428;
  --ochre:#E0A85D; --ochre-t:#3A2E19;
  --clay:#E08A75; --clay-t:#3A211B;
  --rail:#0A0F0B; --rail-t:#8CA091;
  --shadow:0 10px 26px -14px rgba(0,0,0,.6);
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body,.card,.sess,.cal-day,.modal,.toast,.btn,#rail,#topbar,#tabbar,#theme-toggle{transition:background-color .25s,border-color .25s,color .25s,box-shadow .25s}
body{
  font-family:'Public Sans',system-ui,sans-serif; color:var(--ink); background:var(--paper);
  background-image:
    radial-gradient(1100px 500px at 85% -100px, rgba(46,107,79,.07), transparent 60%),
    radial-gradient(900px 500px at -10% 110%, rgba(176,117,43,.06), transparent 60%),
    radial-gradient(rgba(24,36,32,.055) 1px, transparent 1px);
  background-size:auto,auto,22px 22px;
  min-height:100dvh; font-size:15px; line-height:1.45;
}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
input{font:inherit}
.mono{font-family:'Spline Sans Mono',monospace;font-size:.85em}
.serif{font-family:'Fraunces',serif}

#app{display:flex;min-height:100dvh}
#rail{
  width:236px;flex:0 0 236px;background:var(--rail);color:#E8EFE9;
  position:sticky;top:0;height:100dvh;display:flex;flex-direction:column;
  padding:22px 14px 16px;z-index:30;
  background-image:radial-gradient(rgba(255,255,255,.045) 1px, transparent 1px);background-size:18px 18px;
}
.brand{display:flex;gap:11px;align-items:center;padding:2px 10px 20px;border-bottom:1px solid rgba(255,255,255,.09);margin-bottom:14px}
.brand svg{flex:0 0 auto}
.brand b{font-family:'Fraunces',serif;font-weight:600;font-size:21px;letter-spacing:.2px;display:block;line-height:1}
.brand span{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--rail-t)}
.nav-item{
  display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;border-radius:10px;
  color:var(--rail-t);font-weight:600;font-size:14px;position:relative;transition:background .18s,color .18s;margin-bottom:2px;
}
.nav-item svg{flex:0 0 auto;opacity:.85}
.nav-item:hover{background:rgba(255,255,255,.06);color:#fff}
.nav-item.on{background:rgba(46,107,79,.35);color:#fff}
.nav-item.on::before{content:"";position:absolute;left:-14px;top:8px;bottom:8px;width:3px;border-radius:3px;background:#7CC29E}
.rail-foot{margin-top:auto;padding:12px 10px 0;border-top:1px solid rgba(255,255,255,.09);font-size:12.5px;color:var(--rail-t)}
.streak-chip{display:inline-flex;align-items:center;gap:7px;background:rgba(176,117,43,.22);color:#F0C98E;padding:5px 10px;border-radius:99px;font-weight:700;font-size:12.5px}
.rail-foot small{display:block;margin-top:10px;opacity:.65;line-height:1.4}

#main{flex:1;min-width:0;display:flex;flex-direction:column}
#topbar{display:none}
#content{max-width:1180px;width:100%;margin:0 auto;padding:30px 30px 70px}

#tabbar{
  display:none;position:fixed;left:0;right:0;bottom:0;z-index:40;background:var(--rail);
  padding:6px 4px calc(6px + env(safe-area-inset-bottom));
  box-shadow:0 -6px 20px rgba(20,32,27,.25);
}
#tabbar button{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;color:var(--rail-t);font-size:10px;font-weight:700;letter-spacing:.04em;padding:5px 0;border-radius:9px}
#tabbar button.on{color:#fff}
#tabbar button.on svg{transform:translateY(-1px)}
#tabbar svg{transition:transform .2s}

.view{animation:rise .38s cubic-bezier(.2,.7,.3,1) both}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.vhead{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--prim)}
h1.serif{font-size:clamp(28px,4vw,40px);font-weight:560;line-height:1.05;letter-spacing:-.01em}
h1 .thin{font-weight:340;color:var(--mut)}
.sub{color:var(--mut);margin-top:6px;max-width:56ch}

.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 1px 2px rgba(24,36,32,.04)}
.card.p{padding:18px}
.label{font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 15px;border-radius:10px;font-weight:700;font-size:13.5px;border:1px solid transparent;transition:transform .12s,box-shadow .15s,background .15s;white-space:nowrap}
.btn:active{transform:translateY(1px) scale(.99)}
.btn-p{background:var(--ink);color:#F2F4EF}
.btn-p:hover{background:var(--ink2);box-shadow:var(--shadow)}
.btn-a{background:var(--prim);color:#fff}
.btn-a:hover{background:var(--prim-d);box-shadow:var(--shadow)}
.btn-g{background:var(--panel);border-color:var(--line2)}
.btn-g:hover{border-color:var(--faint)}
.btn-d{color:var(--clay);border-color:#E5C4BD;background:var(--panel)}
.btn-d:hover{background:var(--clay-t)}
.btn-sm{padding:6px 11px;font-size:12.5px;border-radius:8px}
.btn-ic{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;border:1px solid var(--line2);background:var(--panel);color:var(--ink);transition:background .15s,transform .15s}
.btn-ic:hover{background:var(--prim-t)}
.btn-ic:disabled{opacity:.35;pointer-events:none}
.spinning svg{animation:spin .7s ease}
@keyframes spin{to{transform:rotate(360deg)}}

.seg{display:inline-flex;background:var(--soft2);border:1px solid var(--line2);border-radius:11px;padding:3px;gap:3px}
.seg button{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13.5px;color:var(--mut);transition:all .15s}
.seg button.on{background:var(--panel);color:var(--ink);box-shadow:0 1px 5px rgba(24,36,32,.16)}

.chip{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:99px;font-size:12px;font-weight:700}
.chip-m{background:var(--chipbg);color:var(--mut);font-family:'Spline Sans Mono',monospace;font-size:11.5px}
.chip-k{font-family:'Spline Sans Mono',monospace;font-size:11.5px}
.k-low{background:var(--clay-t);color:var(--clay)}
.k-mid{background:var(--ochre-t);color:var(--ochre)}
.k-hi{background:var(--prim-t);color:var(--prim)}
.dot{width:9px;height:9px;border-radius:99px;display:inline-block;flex:0 0 auto}

.hero{display:flex;gap:24px;align-items:stretch;flex-wrap:wrap;margin-bottom:20px}
.hero-left{flex:1 1 380px}
.hero-time{display:flex;align-items:baseline;gap:14px;margin:10px 0 4px}
.hero-time .big{font-family:'Fraunces',serif;font-size:clamp(44px,6vw,64px);font-weight:560;line-height:1;letter-spacing:-.02em}
.hero-time .of{color:var(--faint);font-size:14px;font-weight:600}
.ladder-motif{flex:0 0 auto;align-self:center;opacity:.9}
.bar{height:11px;border-radius:99px;background:#E5EAE1;overflow:hidden;position:relative}
.bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--prim-d),var(--prim));transition:width .7s cubic-bezier(.2,.7,.3,1)}
.bar.thin{height:6px}
.done-note{margin-top:8px;font-size:13px;color:var(--mut)}
.done-note b{color:var(--prim)}

.today-ctl{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:22px}
.today-ctl .card{display:flex;align-items:center;gap:14px;padding:12px 16px;flex:1 1 340px}
.today-ctl input[type=range]{flex:1;min-width:140px}
.today-ctl .val{font-family:'Spline Sans Mono',monospace;font-weight:600;font-size:15px;min-width:64px;text-align:right}

.banner{display:flex;gap:12px;align-items:flex-start;border-radius:12px;padding:13px 16px;margin-bottom:16px;font-size:13.5px;line-height:1.5;animation:rise .4s both}
.banner svg{flex:0 0 auto;margin-top:2px}
.banner.warn{background:#FBF3E4;border:1px solid #EBD8B4;color:#7A5A1E}
.banner.info{background:var(--prim-t);border:1px solid #C4DCCF;color:var(--prim-d)}
.banner.clay{background:var(--clay-t);border:1px solid #E5C0B8;color:#8A3A2C}
.banner b{font-weight:800}

.sess-list{display:flex;flex-direction:column;gap:10px}
.sess{
  background:var(--panel);border:1px solid var(--line);border-left:5px solid var(--cc,var(--prim));
  border-radius:var(--r);padding:13px 16px;display:flex;gap:14px;align-items:center;
  cursor:pointer;transition:transform .16s,box-shadow .16s;animation:rise .35s both;position:relative;
}
.sess:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.sess .s-body{flex:1;min-width:0}
.s-course{font-size:10.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);display:flex;align-items:center;gap:7px}
.s-name{font-family:'Fraunces',serif;font-size:19px;font-weight:560;line-height:1.15;margin:2px 0 5px}
.s-meta{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.s-act{display:flex;gap:7px;flex:0 0 auto;align-items:center;justify-content:center}
.s-act .btn-sm{min-width:0;width:auto;justify-content:center;padding:7px 12px;font-size:12.5px}
.sess.done{background:#F3F8F3;border-color:#CFE2D4;border-left-color:var(--prim);opacity:.92}
.sess.done .s-name{text-decoration:line-through;text-decoration-color:rgba(46,107,79,.5);text-decoration-thickness:2px}
.sess.missed{background:#FBF2F0;border-color:#EAD3CC;border-left-color:var(--clay);opacity:.9}
.check-badge{position:absolute;top:-7px;right:-7px;width:24px;height:24px;border-radius:99px;background:var(--prim);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(46,107,79,.4);animation:pop .35s cubic-bezier(.3,1.6,.5,1) both}
@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}

.empty{border:1.5px dashed var(--line2);border-radius:14px;padding:34px 22px;text-align:center;color:var(--mut)}
.empty .serif{font-size:21px;color:var(--ink);margin-bottom:6px}

.cal-nav{display:flex;align-items:center;gap:10px}
.cal-scroll{overflow-x:auto;padding-bottom:10px;scroll-snap-type:x mandatory;scrollbar-width:thin}
.cal-week{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(272px,1fr);gap:13px;min-width:min-content}
.cal-day{scroll-snap-align:start;background:var(--overlay);border:1px solid var(--line);border-radius:14px;padding:11px;display:flex;flex-direction:column;gap:9px;min-height:230px;transition:box-shadow .2s}
.cal-day.today{background:var(--panel);border-color:#BFD8C9;box-shadow:0 0 0 3px rgba(46,107,79,.13)}
.cal-day.past{opacity:.78}
.cd-head{display:flex;align-items:baseline;justify-content:space-between;gap:6px}
.cd-head .dn{font-weight:800;font-size:13px}
.cal-day.today .dn{color:var(--prim)}
.cd-head .dd{font-family:'Fraunces',serif;font-size:19px;font-weight:560}
.cd-cap{margin-bottom:2px}
.cd-cap .row{display:flex;justify-content:space-between;font-size:11px;color:var(--faint);margin-bottom:4px;font-family:'Spline Sans Mono',monospace}
.cd-cap .row .over{color:var(--clay);font-weight:600}
.cal-day .sess{padding:10px 12px}
.cal-day .s-name{font-size:16px}
.rest{font-size:12px;color:var(--faint);text-align:center;padding:16px 6px;border:1.5px dashed var(--line2);border-radius:10px;margin-top:auto}

.course-card{margin-bottom:18px;overflow:hidden;animation:rise .4s both}
.cc-head{display:flex;align-items:center;gap:13px;padding:16px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:linear-gradient(0deg,transparent,rgba(0,0,0,.008))}
.cc-head .dot{width:13px;height:13px}
.cc-name{font-family:'Fraunces',serif;font-size:22px;font-weight:560;flex:1;min-width:140px}
.imp-ctl{display:flex;align-items:center;gap:10px;min-width:200px}
.imp-ctl input{width:110px}
.imp-lab{font-size:12px;font-weight:800;letter-spacing:.05em;min-width:86px}
.imp-1{color:var(--faint)}.imp-2{color:var(--ochre)}.imp-3{color:var(--clay)}
.cc-head .btn-ic{width:30px;height:30px}
.ch-row{display:flex;align-items:center;gap:14px;padding:12px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;transition:background .15s}
.ch-row:last-child{border-bottom:none}
.ch-row:hover{background:#FAFBF8}
.ch-main{flex:1;min-width:170px}
.ch-name{font-weight:700;font-size:14.5px}
.ch-sub{display:flex;gap:8px;align-items:center;margin-top:3px;flex-wrap:wrap;font-size:12px;color:var(--faint)}
.know-ctl{display:flex;align-items:center;gap:10px;flex:1 1 220px;max-width:340px}
.know-ctl input{flex:1}
.know-val{font-family:'Spline Sans Mono',monospace;font-size:13px;font-weight:600;min-width:44px;text-align:right}
.ch-nav{display:flex;flex-direction:column;gap:3px}
.ch-nav .btn-ic{width:24px;height:21px;border-radius:6px}
.ch-nav svg{width:13px;height:13px}
.cc-foot{padding:10px 18px;background:var(--soft)}

.pgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.stat{padding:15px 16px}
.stat .num{font-family:'Fraunces',serif;font-size:30px;font-weight:560;line-height:1.1}
.stat .cap{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-top:3px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:840px){.two-col{grid-template-columns:1fr}}
.bars{display:flex;gap:9px;align-items:flex-end;height:130px;padding-top:8px}
.barcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.barcol .b{width:100%;max-width:36px;border-radius:7px 7px 3px 3px;background:#D9E2D6;min-height:4px;transition:height .6s cubic-bezier(.2,.7,.3,1);position:relative}
.barcol.hot .b{background:var(--ochre)}
.barcol.now .b{background:var(--prim)}
.barcol .bl{font-size:10.5px;font-weight:700;color:var(--faint)}
.barcol .bv{font-family:'Spline Sans Mono',monospace;font-size:10px;color:var(--mut)}
.ring-wrap{display:flex;align-items:center;gap:20px}
.ring-wrap svg{transform:rotate(-90deg)}
.ring-bg{stroke:#E5EAE1}
.ring-fg{stroke:var(--prim);stroke-linecap:round;transition:stroke-dashoffset 1s cubic-bezier(.2,.7,.3,1)}
.att-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.att-row:last-child{border:none}
.att-row .bar{flex:0 0 90px}

.set-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:840px){.set-grid{grid-template-columns:1fr}}
.av-row{display:flex;align-items:center;gap:13px;padding:7px 0}
.av-row .dn{width:96px;font-weight:700;font-size:13.5px}
.av-row input{flex:1}
.av-row .val{font-family:'Spline Sans Mono',monospace;font-size:13px;min-width:62px;text-align:right;font-weight:600}

input[type=range]{-webkit-appearance:none;appearance:none;height:26px;background:transparent;--p:50%;--acc:var(--prim)}
input[type=range]::-webkit-slider-runnable-track{height:7px;border-radius:99px;background:linear-gradient(90deg,var(--acc) var(--p),#DEE4DA var(--p))}
input[type=range]::-moz-range-track{height:7px;border-radius:99px;background:#DEE4DA}
input[type=range]::-moz-range-progress{height:7px;border-radius:99px;background:var(--acc)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:19px;height:19px;border-radius:99px;background:#fff;border:2.5px solid var(--acc);margin-top:-6px;box-shadow:0 1px 5px rgba(24,36,32,.28);transition:transform .12s;cursor:grab}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:99px;background:#fff;border:2.5px solid var(--acc);box-shadow:0 1px 5px rgba(24,36,32,.28);cursor:grab}
input[type=range]:active::-webkit-slider-thumb{transform:scale(1.18);cursor:grabbing}
input[type=range].k-low{--acc:var(--clay)}
input[type=range].k-mid{--acc:var(--ochre)}
input[type=range].k-hi{--acc:var(--prim)}

#modal-root{position:fixed;inset:0;z-index:80;display:none;align-items:flex-end;justify-content:center}
#modal-root.open{display:flex}
.m-ov{position:absolute;inset:0;background:rgba(16,24,20,.5);animation:fade .2s both}
@keyframes fade{from{opacity:0}}
.modal{position:relative;background:var(--panel);color:var(--ink);width:min(480px,100%);border-radius:18px 18px 0 0;padding:24px 22px calc(24px + env(safe-area-inset-bottom));max-height:88dvh;overflow:auto;animation:mup .3s cubic-bezier(.2,.9,.3,1) both;box-shadow:0 -12px 50px rgba(20,32,27,.3)}
@media(min-width:640px){#modal-root{align-items:center}.modal{border-radius:18px;padding-bottom:24px;animation:mpop .25s cubic-bezier(.2,.9,.3,1) both}}
@keyframes mup{from{transform:translateY(60px);opacity:0}}
@keyframes mpop{from{transform:scale(.95) translateY(10px);opacity:0}}
.welc-steps{margin:6px 0 0;padding-left:20px;display:flex;flex-direction:column;gap:7px;font-size:13.5px;color:var(--ink2);line-height:1.4}
.welc-steps li{padding-left:2px}
.m-x{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--mut)}
.m-x:hover{background:var(--soft2)}
.m-title{font-family:'Fraunces',serif;font-size:24px;font-weight:560;line-height:1.15;margin-bottom:4px}
.m-sub{color:var(--mut);font-size:13.5px;margin-bottom:16px}
.m-row{margin-bottom:15px}
.m-row label{display:block;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-bottom:7px}
.tin{width:100%;padding:11px 13px;border:1.5px solid var(--line2);border-radius:10px;font:inherit;background:var(--inputbg);color:var(--ink);transition:border-color .15s,box-shadow .15s}
.tin:focus{outline:none;border-color:var(--prim);box-shadow:0 0 0 3px rgba(46,107,79,.14)}
.m-act{display:flex;gap:9px;justify-content:flex-end;margin-top:20px;flex-wrap:wrap}
.kv{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
.kv:last-child{border:none}
.kv b{font-weight:700}
.preset-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.preset{border:1.5px solid var(--line2);border-radius:10px;padding:10px 8px;text-align:center;font-weight:700;font-size:13px;transition:all .15s}
.preset small{display:block;font-family:'Spline Sans Mono',monospace;font-weight:500;color:var(--faint);margin-top:2px;font-size:11px}
.preset:hover{border-color:var(--prim)}
.preset.sel{border-color:var(--prim);background:var(--prim-t)}
.bigk{font-family:'Fraunces',serif;font-size:46px;font-weight:560;text-align:center;line-height:1;margin:8px 0 2px}
.reason-box{background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:13.5px;color:var(--mut);margin:12px 0;line-height:1.55}
.reason-box b{color:var(--ink)}


/* ── Focus study session ── */
#session-root{position:fixed;inset:0;z-index:120;display:none;background:var(--paper)}
#session-root.open{display:block}
.study-focus{
  position:fixed;inset:0;background:var(--paper);color:var(--ink);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:28px 24px calc(28px + env(safe-area-inset-bottom));
  overflow:hidden;
}
.study-focus::before{content:none}
.study-focus-head{
  position:absolute;top:24px;left:28px;right:28px;z-index:1;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
}
.study-focus-brand{display:flex;align-items:center;gap:9px;font-family:'Fraunces',serif;font-size:20px;font-weight:600}
.study-focus-exit{
  width:40px;height:40px;border:1px solid var(--line2);border-radius:11px;
  display:flex;align-items:center;justify-content:center;background:var(--panel);
}
.study-focus-center{
  position:relative;z-index:1;width:min(760px,100%);text-align:center;
  display:flex;flex-direction:column;align-items:center;
}
.study-focus-label{
  font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  color:var(--prim);margin-bottom:14px;
}
.study-focus-subject{
  font-family:'Fraunces',serif;font-size:clamp(25px,5vw,42px);font-weight:560;
  line-height:1.08;max-width:90vw;
}
.study-focus-course{color:var(--mut);font-size:14px;margin-top:7px}
.study-focus-timer{
  font-family:'Spline Sans Mono',monospace;font-size:clamp(64px,13vw,132px);
  font-weight:500;letter-spacing:-.055em;line-height:1;margin:42px 0 18px;
  font-variant-numeric:tabular-nums;
}
.study-focus-break{height:20px;color:var(--mut);font-size:13px;margin-bottom:22px}
.study-focus-controls{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;width:100%;margin-left:auto;margin-right:auto;transition:gap .25s}
.study-focus-settings{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin:0 auto 18px;width:min(680px,100%);color:var(--mut);font-size:13px;transition:opacity .25s}
.study-focus-settings label{display:flex;align-items:center;gap:7px}
.study-focus-settings select{border:1px solid var(--line2);border-radius:9px;padding:7px 10px;background:var(--panel);color:var(--ink);font:inherit}
.study-focus-settings input{accent-color:var(--prim)}
.study-focus-controls .btn{width:150px;min-width:150px;justify-content:center;padding:9px 14px;font-size:13.5px;line-height:1.2;margin:0}
.study-focus-controls .study-focus-finish{opacity:.55;transition:opacity .25s}
.study-focus-controls .study-focus-finish:hover{opacity:1}
.study-focus-planned{margin-top:16px;color:var(--faint);font-size:12px;transition:opacity .25s}
.study-focus-theme-btn{
  position:absolute;bottom:24px;right:24px;z-index:2;
  width:46px;height:46px;border-radius:50%;border:1px solid var(--line2);
  display:flex;align-items:center;justify-content:center;
  background:var(--ink);color:var(--paper);box-shadow:var(--shadow);
  cursor:pointer;transition:background-color .2s,transform .15s;
}
.study-focus-theme-btn:hover{transform:scale(1.06)}
.study-focus-theme-btn:active{transform:scale(.94)}
@media(max-width:600px){
  .study-focus-theme-btn{bottom:16px;right:16px}
}
@media(max-width:600px){
  .study-focus{padding-left:16px;padding-right:16px}
  .study-focus-head{top:16px;left:16px;right:16px}
  .study-focus-timer{margin:34px 0 16px}
  .study-focus-controls{width:100%;flex-direction:column}
  .study-focus-controls .btn{width:150px;min-width:150px;max-width:150px}
}

#toast-root{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:99;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none;width:min(480px,92vw)}

#theme-toggle{
  position:fixed;bottom:24px;right:24px;z-index:150;
  width:46px;height:46px;border-radius:50%;border:1px solid var(--line2);
  display:flex;align-items:center;justify-content:center;
  background:var(--ink);color:var(--paper);box-shadow:var(--shadow);
  cursor:pointer;transition:right .25s,bottom .25s,background-color .2s,transform .15s;
}
#theme-toggle:hover{transform:scale(1.06)}
#theme-toggle:active{transform:scale(.94)}
@media(max-width:920px){
  #theme-toggle{bottom:78px}
  body.session-active #theme-toggle{bottom:24px}
}
.toast{background:var(--ink);color:#EEF3ED;padding:11px 18px;border-radius:11px;font-size:13.5px;font-weight:600;box-shadow:0 10px 30px rgba(20,32,27,.4);animation:trise .3s cubic-bezier(.2,.9,.3,1) both;display:flex;gap:9px;align-items:center;max-width:100%}
.toast.good{background:var(--prim-d)}
.toast.bad{background:#7C352A}
@keyframes trise{from{opacity:0;transform:translateY(14px) scale(.97)}}
.toast.out{animation:tfade .3s both}
@keyframes tfade{to{opacity:0;transform:translateY(8px)}}

.examcard{border:1.5px solid #EBD8B4;background:#FBF3E4;border-radius:12px;padding:11px 14px;display:flex;gap:11px;align-items:center;margin-bottom:9px}
.examcard .ex-body{flex:1;min-width:0}
.examcard .ex-date{font-family:'Fraunces',serif;font-size:16px;font-weight:560;color:#7A5A1E}
.examcard .ex-list{font-size:12px;color:#8A6A2E;margin-top:2px}
.pick-list{max-height:260px;overflow:auto;border:1px solid var(--line2);border-radius:10px;padding:4px}
.pick-course{padding:8px 10px}
.pick-course-head{display:flex;align-items:center;gap:9px;font-weight:700;font-size:13.5px;padding:4px 0}
.pick-ch{display:flex;align-items:center;gap:9px;padding:5px 0 5px 24px;font-size:13px;color:var(--mut)}
.pick-course label,.pick-ch label{display:flex;align-items:center;gap:9px;cursor:pointer;width:100%}
input[type=checkbox]{width:16px;height:16px;accent-color:var(--prim);flex:0 0 auto}
input[type=date]{width:100%;padding:11px 13px;border:1.5px solid var(--line2);border-radius:10px;font:inherit;background:var(--inputbg);color:var(--ink)}

/* ── Tutorial ── */
.tut-progress{display:flex;gap:5px;margin-bottom:16px}
.tut-progress i{flex:1;height:4px;border-radius:99px;background:var(--line2)}
.tut-progress i.on{background:var(--prim)}
.tut-progress i.past{background:var(--prim);opacity:.5}
.tut-visual{background:var(--soft);border:1px solid var(--line);border-radius:12px;padding:16px;margin:4px 0 16px;display:flex;align-items:center;justify-content:center;min-height:120px}
.tut-step-num{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:99px;background:var(--prim-t);color:var(--prim-d);font-weight:800;font-size:12.5px;margin-bottom:8px}
.tut-nav{display:flex;justify-content:space-between;align-items:center;margin-top:18px;gap:10px}
.tut-skip{color:var(--faint);font-size:12.5px;font-weight:700}
.tut-skip:hover{color:var(--mut)}
.tut-mock-sess{background:var(--panel);border:1px solid var(--line);border-left:5px solid var(--prim);border-radius:10px;padding:10px 13px;display:flex;align-items:center;gap:10px;width:100%}
.tut-mock-sess .s-act{margin-left:auto}
.tut-mock-cal{display:flex;gap:8px;width:100%}
.tut-mock-cal .d{flex:1;border:1px solid var(--line);border-radius:9px;padding:7px;text-align:center;font-size:11px;background:var(--panel)}
.tut-mock-cal .d.hi{border-color:#BFD8C9;background:var(--prim-t)}
.tut-mock-cal .d b{display:block;font-family:'Fraunces',serif;font-size:15px;font-weight:560;margin-top:2px}
.choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px}
.choice-card{border:1.5px solid var(--line2);border-radius:12px;padding:16px 14px;text-align:left;transition:all .15s}
.choice-card:hover{border-color:var(--prim);box-shadow:var(--shadow)}
.choice-card .serif{font-size:17px;margin-bottom:4px}
.choice-card p{font-size:12.5px;color:var(--mut);line-height:1.4}

@media(max-width:920px){
  #rail{display:none}
  #topbar{display:flex;align-items:center;justify-content:space-between;background:var(--rail);color:#fff;padding:12px 16px;position:sticky;top:0;z-index:35}
  #topbar .brand{padding:0;border:none;margin:0}
  #content{padding:18px 14px 110px;overflow-x:hidden}
  #tabbar{display:flex}
  .s-act{width:100%;justify-content:flex-end}
  .sess{flex-wrap:wrap}
  .choice-grid{grid-template-columns:1fr}
  .today-ctl{gap:10px;margin-bottom:18px}
  .today-ctl .card{flex:1 1 100%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px 12px;padding:11px 13px}
  .today-ctl .card .label{white-space:normal!important;line-height:1.25;min-width:0}
  .today-ctl input[type=range]{grid-column:1 / -1;width:100%;min-width:0}
  .today-ctl .val{font-size:14px;min-width:58px}
  .modal{width:100%;max-height:92dvh;padding:20px 16px calc(18px + env(safe-area-inset-bottom));border-radius:16px 16px 0 0}
  .m-title{font-size:24px;line-height:1.12;padding-right:28px}
  .m-sub{line-height:1.45}
  .m-act{flex-wrap:wrap;gap:8px}
  .m-act .btn{min-height:42px}
}
@media(max-width:420px){
  #content{padding-left:12px;padding-right:12px}
  .today-ctl .card{grid-template-columns:1fr auto}
  .today-ctl .card .label{font-size:12px}
  .today-ctl .val{font-size:13px}
  .m-act .btn{flex:1 1 100%;justify-content:center}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
