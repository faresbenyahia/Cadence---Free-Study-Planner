  renderStudySession();
  {
    const theme = document.documentElement.getAttribute("data-theme")==="dark" ? "dark" : "light";
    const sbtn=$("#study-focus-theme");
    if(sbtn) sbtn.innerHTML = theme==="dark" ? ico("sun",19) : ico("moon",19);
  }
  const breakEnabledEl=$("#session-break-enabled");
  const breakIntervalEl=$("#session-break-interval");
  const breakDurationEl=$("#session-break-duration");
  const syncBreakSettings=()=>{
    if(!activeStudySession) return;
    activeStudySession.breakEnabled=!!breakEnabledEl?.checked;
    activeStudySession.breakInterval=+(breakIntervalEl?.value||30);
    activeStudySession.breakDuration=+(breakDurationEl?.value||5);
    activeStudySession.breaksTotal=sessionPlannedBreaks(totalMinutes,activeStudySession.breakInterval,activeStudySession.breakEnabled);
    renderStudySession();
  };
  breakEnabledEl?.addEventListener("change",syncBreakSettings);
  breakIntervalEl?.addEventListener("change",syncBreakSettings);
  breakDurationEl?.addEventListener("change",syncBreakSettings);
  studyTimer=setInterval(tickStudySession,1000);

  const root=$("#session-root");
  if(root.requestFullscreen) root.requestFullscreen().catch(()=>{});
}

function tickStudySession(){
  if(!activeStudySession || !activeStudySession.running) return;
  const now=Date.now();
  const delta=Math.max(0,Math.min(2,Math.floor((now-activeStudySession.lastTick)/1000)));
  activeStudySession.lastTick=now;
  if(!delta) return;

  if(activeStudySession.breakActive){
    activeStudySession.breakRemaining=Math.max(0,activeStudySession.breakRemaining-delta);
    if(activeStudySession.breakRemaining===0){
      activeStudySession.breakActive=false;
      activeStudySession.running=false;
      activeStudySession.breaksCompleted++;
      activeStudySession.lastTick=0;
    }
  } else {
    const before=Math.floor((activeStudySession.totalSeconds-activeStudySession.remaining)/60);
    activeStudySession.remaining=Math.max(0,activeStudySession.remaining-delta);
    activeStudySession.studySeconds+=delta;
    const after=Math.floor((activeStudySession.totalSeconds-activeStudySession.remaining)/60);

    const nextBreak=activeStudySession.breaksCompleted+1;
    if(activeStudySession.breakEnabled && activeStudySession.breaksCompleted<activeStudySession.breaksTotal && after>=nextBreak*activeStudySession.breakInterval){
      activeStudySession.breakActive=true;
      activeStudySession.running=false;
      activeStudySession.breakRemaining=activeStudySession.breakDuration*60;
      activeStudySession.breakNumber=nextBreak;
      activeStudySession.lastTick=0;
    }
    if(activeStudySession.remaining===0){
      activeStudySession.running=false;
      activeStudySession.lastTick=0;
    }
  }
  renderStudySession();
}

function resumeSession(){
  if(!activeStudySession || activeStudySession.breakActive || activeStudySession.remaining<=0) return;
  activeStudySession.running=true;
  activeStudySession.lastTick=Date.now();
  renderStudySession();
}

function pauseSession(){
  if(!activeStudySession || !activeStudySession.running || activeStudySession.breakActive) return;
  activeStudySession.running=false;
  activeStudySession.lastTick=0;
  renderStudySession();
}

function startBreak(){
  if(!activeStudySession || !activeStudySession.breakActive) return;
  activeStudySession.running=true;
  activeStudySession.lastTick=Date.now();
  renderStudySession();
}

function endStudySession(restoreScroll=true){
  if(studyTimer){ clearInterval(studyTimer); studyTimer=null; }
  activeStudySession=null;
  $("#session-root").classList.remove("open");
  $("#session-root").innerHTML="";
  document.body.classList.remove("session-active");
  document.body.style.overflow="";
  if(document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(()=>{});
  if(restoreScroll) render();
}

function finishStudySession(id){
  if(!activeStudySession || activeStudySession.id!==id) return;
  const studiedSeconds=activeStudySession.studySeconds;
  activeStudySession.elapsed=studiedSeconds;
  if(studyTimer){ clearInterval(studyTimer); studyTimer=null; }
  $("#session-root").classList.remove("open");
  $("#session-root").innerHTML="";
  document.body.classList.remove("session-active");
  document.body.style.overflow="";
  if(document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(()=>{});
  const studiedMinutes=Math.max(1,Math.round(studiedSeconds/60));
  completeModal(id, studiedMinutes);
}

