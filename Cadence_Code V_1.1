/* ════════════════ Focus study session ════════════════ */
let activeStudySession=null;
let studyTimer=null;

function formatChrono(seconds){
  seconds=Math.max(0,Math.floor(seconds));
  const h=Math.floor(seconds/3600);
  const m=Math.floor((seconds%3600)/60);
  const sec=seconds%60;
  return h
    ? `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(sec).padStart(2,"0")}`
    : `${String(m).padStart(2,"0")}:${String(sec).padStart(2,"0")}`;
}

function sessionPlannedBreaks(totalMinutes, interval=30, enabled=true){
  if(!enabled || interval<=0) return 0;
  return Math.max(0, Math.floor((Math.max(0,totalMinutes)-1)/interval));
}

function renderStudySession(){
  if(!activeStudySession) return;
  const s=state.schedule.find(x=>x.id===activeStudySession.id);
  if(!s){ endStudySession(false); return; }
  const f=findChapter(s.chapterId);
  if(!f){ endStudySession(false); return; }
  const {ch,c}=f;

  const timerEl=$("#study-focus-timer");
  const subjectEl=$("#study-focus-subject");
  const courseEl=$("#study-focus-course");
  const plannedEl=$("#study-focus-planned");
  const stateEl=$("#study-focus-state");
  const actionEl=$("#study-focus-action");
  const breakEl=$("#study-focus-break");

  if(timerEl) timerEl.textContent=formatChrono(activeStudySession.remaining);
  if(subjectEl) subjectEl.textContent=ch.name;
  if(courseEl) courseEl.textContent=c.name;
  if(plannedEl) plannedEl.textContent=t("session_planned",{t:fmtDur(s.dur)});

  if(activeStudySession.breakActive){
    if(stateEl) stateEl.textContent=t("session_break");
    if(breakEl) breakEl.textContent=t("session_break_count",{n:activeStudySession.breakNumber});
    if(actionEl){
      actionEl.dataset.act="startBreak";
      actionEl.innerHTML=t("session_start_break");
    }
    if(timerEl) timerEl.textContent=formatChrono(activeStudySession.breakRemaining);
    return;
  }

  if(stateEl) stateEl.textContent=activeStudySession.running?t("session_running"):t("session_paused");
  if(breakEl) breakEl.textContent=activeStudySession.breaksTotal
    ? t("session_breaks_done",{n:activeStudySession.breaksCompleted,t:activeStudySession.breaksTotal})
    : "";
  const settingsEl=$("#study-focus-settings");
  const showSettings=!activeStudySession.running && activeStudySession.studySeconds===0;
  if(settingsEl) settingsEl.style.display=showSettings ? "flex" : "none";
  if(plannedEl) plannedEl.style.opacity=activeStudySession.running ? "0" : ".7";
  if(actionEl){
    actionEl.dataset.act=activeStudySession.running?"pauseSession":"resumeSession";
    actionEl.innerHTML=activeStudySession.running
      ? t("session_pause")
      : t("session_start");
  }
}

function startSession(id){
  const s=state.schedule.find(x=>x.id===id);
  if(!s) return;
  const f=findChapter(s.chapterId);
  if(!f) return;
  if(activeStudySession) endStudySession(false);
  closeModal();

  const totalSeconds=Math.max(60,Math.round(s.dur*60));
