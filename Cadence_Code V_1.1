/* ════════════════ Store ════════════════ */
const Store = {
  key: "cadence.v1",
  load(){ try{ const raw = localStorage.getItem(this.key); return raw?JSON.parse(raw):null; }catch(e){ return null; } },
  save(state){ try{ localStorage.setItem(this.key, JSON.stringify(state)); }catch(e){} },
  clear(){ localStorage.removeItem(this.key); },
};
function defaultState(){
  return {
    v:1, onboarded:false, courses:[],
    availability:[180,120,60,180,120,300,240],
    overrides:{},
    settings:{ locale:"en" },
    schedule:[], history:[], planMeta:{}, exams:[],
  };
}

/* ════════════════ i18n helpers (need state → defined after it loads) ════════════════ */
let state = Store.load() || defaultState();
state.settings = Object.assign({locale:"en"}, state.settings||{});
if(!Array.isArray(state.exams)) state.exams=[];

function L(){ return I18N[state.settings.locale] || I18N.en; }
function t(k,p){
  let s = (L()[k] !== undefined ? L()[k] : (I18N.en[k] !== undefined ? I18N.en[k] : k));
  if(p) for(const key in p) s = s.split("{"+key+"}").join(p[key]);
  return s;
}
const fmtDur  = m => L().dur(m);
const fmtDate = d => L().dateShort(d);
const fmtShort= d => L().dateTiny(d);
function impWord(i){ return t(i>=3?"imp3":i===2?"imp2":"imp1"); }
const impDots = i => "●".repeat(i)+"○".repeat(3-i);
function kClass(k){ return k<40?"k-low":k<70?"k-mid":"k-hi"; }

/* ════════════════ Engine — spaced repetition core ════════════════ */
const Engine = {
  remainingReps(k){ for(const [cap,reps] of CONFIG.repLadder) if(k<cap) return reps; return 1; },
  interval(ch, imp, n){
    const g = CONFIG.baseGap(ch.knowledge) * Math.pow(CONFIG.growth(ch.knowledge), n-1) * CONFIG.impFactor(imp);
    return clampN(Math.round(g), 1, CONFIG.maxGapDays);
  },
  duration(ch, n, target){
    const band = CONFIG.durationBands.find(b => ch.knowledge < b[0]) || CONFIG.durationBands.at(-1);
    const lo=band[1], hi=band[2];
    const prog = (n-1)/Math.max(1, target-1);
    return Math.max(10, Math.round((hi-(hi-lo)*prog)/5)*5);
  },
  score(q, onDate=null){
    const w=CONFIG.w, ch=q.ch;
    let s = ch.importance*w.importance + ((100-ch.knowledge)/25)*w.knowledge
         + q.overdue*w.overdue + (ch.repsDone===0 && ch.knowledge<=10 ? w.fresh : 0)
         + q.remaining*w.remaining;
    if(ch.examDeadline){
      const anchor = onDate || q.due;
      const daysLeft = Math.max(1, diffD(fromISO(ch.examDeadline), anchor));
      s += w.exam * (CONFIG.horizonDays / daysLeft);
    }
    return s;
  },
};

/* ════════════════ Optimizer ════════════════ */
function buildPlan(state){
  const start = startOfToday();
  const end = addD(start, CONFIG.horizonDays);
  const todayISO = toISO(start);

  const doneByISO={};
  for(const h of state.history) if(h.status==="done" || h.status==="missed") doneByISO[h.date]=(doneByISO[h.date]||0)+h.dur;

  const days=[];
  for(let i=0;i<CONFIG.horizonDays;i++){
    const d=addD(start,i), iso=toISO(d);
    let cap = state.availability[wdIdx(d)];
    if(state.overrides[iso]!=null) cap = state.overrides[iso];
    const rem = Math.max(0, cap - (doneByISO[iso]||0));
    days.push({date:d, iso, rem, items:[], set:new Set()});
  }

  const queue=[];
  for(const c of state.courses) for(const ch of c.chapters){
    if(ch.status==="done" && !ch.dueDate) continue;
    if(ch.repsDone >= ch.target && !ch.dueDate) continue;

    const total = Math.max(ch.target, ch.repsDone + (ch.dueDate?1:0));
    const remainingReps = total - ch.repsDone;

    if(ch.examDeadline){
      /*
       * Exam mode:
       * - Every remaining repetition gets a hard latest date: the day BEFORE the exam.
       * - Repetitions are spread across the whole available window, starting today.
       * - The optimizer may pull a repetition earlier when the chapter is becoming
       *   impossible to finish, so normal sessions cannot silently consume exam capacity.
       */
      const deadlineD = fromISO(ch.examDeadline);
      const latestD = addD(deadlineD,-1);
      const spanDays = diffD(latestD,start);

      if(spanDays < 0){
        continue;
      }

      for(let rep=ch.repsDone+1; rep<=total; rep++){
        const idx = rep - ch.repsDone; // 1-based repetition number still to do
        const offset = remainingReps<=1
          ? 0
          : Math.round((idx-1) * spanDays / (remainingReps-1));
        const plannedDate = addD(start, Math.max(0, Math.min(offset, spanDays)));

        queue.push({
          ch, course:c, rep, target:ch.target,
          due:plannedDate,
          plannedDate,
          latestDate:latestD,
          dur:Engine.duration(ch, idx, ch.target),
          placed:false,
          remaining:remainingReps,
          overdue:0,
          exam:true
        });
      }
      continue;
    }

    let prev = ch.dueDate ? fromISO(ch.dueDate)
             : ch.lastStudied ? addD(fromISO(ch.lastStudied), Engine.interval(ch,c.importance,1))
             : start;
    let ord=1;
    for(let rep=ch.repsDone+1; rep<=total; rep++){
      const due = rep===ch.repsDone+1 ? prev : addD(prev, Engine.interval(ch,c.importance,ord));
      prev=due; ord++;
      if(diffD(due,end)>0) break;
      queue.push({
        ch, course:c, rep, target:ch.target, due,
        dur:Engine.duration(ch, ord-1, ch.target),
        placed:false,
        remaining:remainingReps,
        overdue:0,
        exam:false
      });
    }
  }

  const dueToday = queue.filter(q=>diffD(q.due,start)<=0);
  const todayDemandMin = dueToday.reduce((s,q)=>s+q.dur,0);

  /*
   * A chapter under an exam gets a "slack" value:
   *   days still available before the exam - repetitions still unplaced.
   * When slack reaches 0, the next repetition becomes mandatory that day.
   * This is what makes the exam deadline a real constraint rather than just a
   * higher priority score.
   */
  function examState(q, day){
    const remaining = queue.filter(x => x.exam && !x.placed && x.ch.id===q.ch.id).length;
    const daysLeft = Math.max(0, diffD(q.latestDate,day.date)+1);
    return {remaining, daysLeft, urgent: remaining >= daysLeft};
  }

  for(const day of days){
    let guard=0;
    while(day.rem>0 && day.items.length<CONFIG.maxSessionsPerDay && guard++<24){
      let q=null;

      // 1) Exam work gets first claim on capacity.
      const examDue = queue.filter(x =>
        !x.placed &&
        !day.set.has(x.ch.id) &&
        x.exam &&
        diffD(x.latestDate,day.date)>=0 &&
        (diffD(x.due,day.date)<=0 || examState(x,day).urgent) &&
        x.dur<=day.rem
      );

      if(examDue.length){
        examDue.sort((a,b)=>{
          const sa=examState(a,day), sb=examState(b,day);
          if(sa.urgent!==sb.urgent) return sa.urgent ? -1 : 1;
          if(sa.urgent && sb.urgent){
            // Hardest-to-fit chapters first; then preserve repetition order.
            if(sa.daysLeft!==sb.daysLeft) return sa.daysLeft-sb.daysLeft;
          }
          if(a.plannedDate.getTime()!==b.plannedDate.getTime())
            return a.plannedDate-b.plannedDate;
          if(a.ch.id===b.ch.id && a.rep!==b.rep) return a.rep-b.rep;
          return Engine.score(b,day.date)-Engine.score(a,day.date);
        });
        q=examDue[0];
      }

      // 2) Normal due work only after exam work has been given its chance.
      if(!q){
        const due = queue.filter(x =>
          !x.placed &&
          !x.exam &&
          !day.set.has(x.ch.id) &&
          diffD(x.due,day.date)<=0 &&
          x.dur<=day.rem
        ).sort((a,b)=>Engine.score(b,day.date)-Engine.score(a,day.date));
        q=due[0];
      }

      // 3) Optional prefetch remains available for normal sessions only.
      if(!q){
        const lim=addD(day.date,CONFIG.prefetchDays);
        const pc=queue.filter(x =>
          !x.placed &&
          !x.exam &&
          !day.set.has(x.ch.id) &&
          diffD(x.due,day.date)>0 &&
          diffD(lim,x.due)>=0 &&
          x.dur<=day.rem
        ).sort((a,b)=>Engine.score(b,day.date)-Engine.score(a,day.date));
        q=pc[0];
      }

      if(!q) break;

      q.placed=true;
      q.overdue=Math.max(0,diffD(day.date,q.due));
      day.set.add(q.ch.id);
      day.rem-=q.dur;
      day.items.push({q,dur:q.dur});
    }
  }

  const sessions=[];
  for(const day of days){
    day.items.sort((a,b)=>Engine.score(b.q,day.date)-Engine.score(a.q,day.date));
    for(const {q,dur} of day.items){
      const ch=q.ch, c=q.course;
      const bits=[];
      if(ch.examDeadline) bits.push({k:"exam", d:fmtShort(fromISO(ch.examDeadline))});
      if(q.rep===1 && ch.repsDone===0 && !ch.lastStudied) bits.push(ch.knowledge<=10?{k:"new"}:{k:"first"});
      if(q.overdue>0) bits.push({k:"od", d:q.overdue});
      if(c.importance>=3) bits.push({k:"top"}); else if(c.importance<=1) bits.push({k:"lowp"});
      if(ch.knowledge<40) bits.push({k:"lowm"}); else if(ch.knowledge>=80) bits.push({k:"maint"});
      bits.push({k:"rev", a:q.rep, b:q.target});
      sessions.push({
        id:uid(),
        chapterId:ch.id,
        courseId:c.id,
        date:day.iso,
        dur,
        rep:q.rep,
        target:q.target,
        reason:bits
      });
    }
  }

  // Keep "unplaced" for the general planner, and separately track exam work
  // whose hard deadline is already inside the computed horizon.
  const unplaced = queue.filter(q=>!q.placed && diffD(q.due,end)<=0).length;
  const examUnplaced = queue.filter(q =>
    q.exam && !q.placed && diffD(q.latestDate,end)<=0
  ).length;

  return {
    sessions,
    meta:{
      todayDemandMin,
      todayDemandCount:dueToday.length,
      unplaced,
      examUnplaced,
      todayISO
    }
  };
}
function rebuild(save=true){
  const plan = buildPlan(state);
  state.schedule = plan.sessions;
  state.planMeta = plan.meta;
  if(save) Store.save(state);
}

/* ════════════════ derived helpers ════════════════ */
function findChapter(id){ for(const c of state.courses){ const ch=c.chapters.find(x=>x.id===id); if(ch) return {ch,c}; } return null; }
function capacityFor(d){ const iso=toISO(d); return state.overrides[iso]!=null ? state.overrides[iso] : state.availability[wdIdx(d)]; }
function loadByISO(){ const m={}; for(const s of state.schedule) m[s.date]=(m[s.date]||0)+s.dur; return m; }
function nextByChapter(){ const m={}; for(const s of state.schedule) if(!m[s.chapterId]||s.date<m[s.chapterId]) m[s.chapterId]=s.date; return m; }
function streak(){
  const set=new Set(state.history.filter(h=>h.status==="done").map(h=>h.date));
  let n=0, d=startOfToday();
  if(!set.has(toISO(d))) d=addD(d,-1);
  while(set.has(toISO(d))){ n++; d=addD(d,-1); }
  return n;
}
function activeCount(){ let n=0; for(const c of state.courses) n+=c.chapters.filter(ch=>ch.status!=="done").length; return n; }
function reasonText(bits){ return bits.map(b=>t("r_"+b.k,b)).join(" · "); }

/* ════════════════ exam deadlines — recompute per-chapter from state.exams ════════════════ */
function recomputeExamDeadlines(){
  for(const c of state.courses) for(const ch of c.chapters) ch.examDeadline=null;
  for(const ex of state.exams){
    for(const chId of ex.chapterIds){
      const f=findChapter(chId); if(!f) continue;
      if(!f.ch.examDeadline || ex.date < f.ch.examDeadline) f.ch.examDeadline = ex.date;
    }
  }
}

/* ════════════════ Actions ════════════════ */
let currentView="today", weekOffset=0;

function completeSession(sessId, newK, studiedDur){
  const i=state.schedule.findIndex(s=>s.id===sessId); if(i<0) return;
  const s=state.schedule[i]; const f=findChapter(s.chapterId); if(!f) return;
  const {ch}=f;
  state.schedule.splice(i,1);
  state.history.push({...s, dur:studiedDur||s.dur, status:"done", doneAt:Date.now(), newK, courseName:f.c.name, chapterName:ch.name});
  ch.repsDone++; ch.knowledge=newK; ch.lastStudied=s.date; ch.dueDate=null;
  ch.target = ch.repsDone + Engine.remainingReps(newK);
  let msg;
  if(ch.repsDone>=ch.target){ ch.status="done"; msg=t("toast_mastered",{name:ch.name}); }
  else { ch.status="active"; rebuild(false);
    const nx=state.schedule.find(x=>x.chapterId===ch.id);
    msg = nx ? t("toast_next",{name:ch.name,k:newK,d:fmtShort(fromISO(nx.date))})
             : t("toast_nonext",{name:ch.name,k:newK});
  }
  rebuild(); render(); toast(msg,"good");
}
function missSession(sessId, silent){
  const i=state.schedule.findIndex(s=>s.id===sessId); if(i<0) return;
  const s=state.schedule[i]; const f=findChapter(s.chapterId); if(!f) return;
  const {ch,c}=f;
  state.schedule.splice(i,1);
  state.history.push({...s, status:"missed", previousDueDate:ch.dueDate??null, courseName:c.name, chapterName:ch.name});
  ch.dueDate = toISO(addD(fromISO(s.date),1));
  ch.status="active";
  rebuild();
  if(!silent){ render(); toast(t("toast_miss",{name:ch.name}),"bad"); }
}
function undoMissed(historyId){
  const i=state.history.findIndex(h=>h.id===historyId && h.status==="missed");
  if(i<0) return;
  const h=state.history[i];
  const f=findChapter(h.chapterId); if(!f) return;
  const {ch}=f;

  state.history.splice(i,1);
  ch.dueDate = h.previousDueDate ?? null;
  ch.status = "active";

  // Restore the exact session that was marked missed.
  const exists=state.schedule.some(s=>s.id===h.id);
  if(!exists) state.schedule.push({...h, status:undefined, previousDueDate:undefined, courseName:undefined, chapterName:undefined});

  state.schedule.forEach(s=>{ delete s.status; delete s.previousDueDate; delete s.courseName; delete s.chapterName; });
  state.schedule.sort((a,b)=>a.date.localeCompare(b.date));
  Store.save(state);
  render();
  toast(t("toast_undo_missed",{name:h.chapterName||f.ch.name}),"good");
}
function markMissedDay(iso){
  // Take a snapshot first. Do not call missSession() here because it rebuilds
  // the schedule after each item, which changes state.schedule mid-loop.
  const daySessions = state.schedule.filter(s=>s.date===iso);
  if(!daySessions.length){ toast(t("toast_nothing")); return; }

  let missedCount = 0;
  for(const s of daySessions){
    const f=findChapter(s.chapterId);
    if(!f) continue;
    const {ch,c}=f;

    // Preserve every scheduled session in history as missed.
    state.history.push({
      ...s,
      status:"missed",
      previousDueDate:ch.dueDate??null,
      courseName:c.name,
      chapterName:ch.name
    });

    // Push the chapter's next due date to tomorrow.
    ch.dueDate = toISO(addD(fromISO(s.date),1));
    ch.status = "active";
    missedCount++;
  }

  // Remove all of today's sessions in one operation, then rebuild once.
  state.schedule = state.schedule.filter(s=>s.date!==iso);
  rebuild();
  render();
  toast(t("toast_missday",{n:missedCount}), "bad");
}
function setKnowledge(chId,k){
  const f=findChapter(chId); if(!f) return; const {ch}=f;
  ch.knowledge=k;
  const rem = k>=100 && ch.repsDone>0 ? 1 : Engine.remainingReps(k);
  ch.target = Math.max(ch.repsDone+(k>=100&&ch.repsDone>0?0:1), ch.repsDone+rem);
  if(ch.target<=ch.repsDone) ch.status="done"; else ch.status="active";
  rebuild(); render(); toast(t("toast_k"),"good");
}
function restartChapter(chId){
  const f=findChapter(chId); if(!f) return; const {ch}=f;
  ch.repsDone=0; ch.dueDate=null; ch.lastStudied=null; ch.status="active";
  ch.target=Engine.remainingReps(ch.knowledge);
  rebuild(); render(); toast(t("toast_restart",{name:ch.name,n:ch.target}),"good");
}
function reviewAgain(chId){
  const f=findChapter(chId); if(!f) return; const {ch}=f;
  ch.status="active"; ch.target=ch.repsDone+1; ch.dueDate=toISO(startOfToday());
  rebuild(); render(); toast(t("toast_review_again",{name:ch.name}),"good");
}
function setLocale(loc){
  state.settings.locale = loc; Store.save(state);
  document.documentElement.lang = loc;
  renderNav(); render(); toast(t("toast_lang"),"good");
}
function addExam(dateISO, chapterIds){
  // For each targeted chapter, ensure it can still be fully mastered: raise target reps if needed.
  for(const chId of chapterIds){
    const f=findChapter(chId); if(!f) continue; const {ch}=f;
    ch.status="active"; ch.dueDate=null;
    ch.target = Math.max(ch.target, ch.repsDone + Engine.remainingReps(ch.knowledge));
  }
  const ex={id:uid(), date:dateISO, chapterIds:[...chapterIds]};
  state.exams.push(ex);
  recomputeExamDeadlines();
  rebuild(); render();
  const pm=state.planMeta||{};
  if(pm.examUnplaced>0) toast(t("exam_tight",{d:fmtShort(fromISO(dateISO)),n:pm.examUnplaced}),"bad");
  else toast(t("toast_exam_added",{n:chapterIds.length,d:fmtShort(fromISO(dateISO))}),"good");
}
function deleteExam(examId){
  state.exams = state.exams.filter(e=>e.id!==examId);
  recomputeExamDeadlines();
  rebuild(); render(); toast(t("toast_exam_del"),"bad");
}

