function banner(kind,html){ return `<div class="banner ${kind}">${ico(kind==="info"?"check":"warn",17)}<div>${html}</div></div>`; }
function attentionList(n){
  const list=[];
  for(const c of state.courses) for(const ch of c.chapters){
    if(ch.status==="done") continue;
    list.push({ch,c,score: c.importance*CONFIG.w.importance + ((100-ch.knowledge)/25)*CONFIG.w.knowledge});
  }
  return list.sort((a,b)=>b.score-a.score).slice(0,n);
}

