      <div class="study-focus-center">
        <div class="study-focus-label" id="study-focus-state">${t("session_paused")}</div>
        <div class="study-focus-subject" id="study-focus-subject"></div>
        <div class="study-focus-course" id="study-focus-course"></div>
        <div class="study-focus-timer" id="study-focus-timer" aria-live="off"></div>
        <div class="study-focus-break" id="study-focus-break"></div>
        <div class="study-focus-settings" id="study-focus-settings">
          <label><input type="checkbox" id="session-break-enabled" checked> ${t("session_auto_breaks")}</label>
          <label>${t("session_every")} <select id="session-break-interval"><option value="15">15 min</option><option value="30" selected>30 min</option><option value="45">45 min</option><option value="60">60 min</option></select></label>
          <label>${t("session_break_for")} <select id="session-break-duration"><option value="5">5 min</option><option value="10">10 min</option><option value="15">15 min</option></select></label>
        </div>
