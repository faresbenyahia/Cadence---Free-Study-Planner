/* ════════════════ Toast ════════════════ */
function toast(msg, kind=""){
  const tEl=document.createElement("div"); tEl.className="toast "+kind; tEl.innerHTML=msg;
  $("#toast-root").appendChild(tEl);
  setTimeout(()=>{tEl.classList.add("out"); setTimeout(()=>tEl.remove(),320);},3600);
}

